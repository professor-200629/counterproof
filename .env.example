# CounterProof configuration. Copy to .env (git-ignored) or run scripts/keygen.py.
# Never commit real keys. The API never returns these values; target sandboxes never receive them.

# --- network -------------------------------------------------------------------------
# anvil-local  : local anvil chain 31337 (scripts/dev.py starts it) - NOT Monad
# monad-testnet: Monad Testnet, chain 10143 (https://testnet-rpc.monad.xyz)
# offchain     : no chain; evidence only, no rewards
COUNTERPROOF_NETWORK=anvil-local
# Optional RPC override (defaults: anvil http://127.0.0.1:8545, testnet https://testnet-rpc.monad.xyz)
COUNTERPROOF_RPC_URL=
# Deployed CounterProofBounties address on the selected network
COUNTERPROOF_CONTRACT=

# --- evaluator (declared trusted party) -------------------------------------------------
# Address written into every challenge spec; must match the signer's key.
COUNTERPROOF_EVALUATOR_ADDRESS=
# Only the signer process (python -m counterproof.signer) reads this key.
EVALUATOR_PRIVATE_KEY=
# Shared secret between API/worker and the signer (localhost only).
COUNTERPROOF_SIGNER_TOKEN=
COUNTERPROOF_SIGNER_URL=http://127.0.0.1:8011

# --- challenger bot (optional) -----------------------------------------------------------
# Commits candidate digests on chain and receives rewards. Without it, challengers commit
# from their own wallet and reveal via POST /api/challenges/{id}/submissions.
COUNTERPROOF_CHALLENGER_PRIVATE_KEY=
COUNTERPROOF_CHALLENGER_RECIPIENT=

# --- deployment / scripted testnet run (scripts only) -------------------------------------
DEPLOYER_PRIVATE_KEY=
PUBLISHER_PRIVATE_KEY=
# posts ERC-8004 reputation feedback for settled results (scripts only)
REPORTER_PRIVATE_KEY=

# --- isolation -----------------------------------------------------------------------------
# process  : fresh child process, no secrets, socket guard, OS limits (first-party adapters only)
# container: Docker, no network, read-only, non-root (needs a running engine + built image)
COUNTERPROOF_ISOLATION=process
COUNTERPROOF_TARGET_IMAGE=counterproof-target:dev

# --- live-model mode (optional) -------------------------------------------------------------
# Deterministic mode needs none of this. Providers: groq | openai | openrouter
COUNTERPROOF_LLM_PROVIDER=
COUNTERPROOF_LLM_MODEL=
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- who may change things (API only; backend/counterproof/auth.py) --------------------------
# Reads are public. Every change needs the operator token (scripts: Authorization: Bearer ...)
# or a judge session (the web "Judge sign-in" with the passcode; 8 h, HttpOnly cookie + CSRF).
# With neither set, every change is refused. scripts/dev.py generates both per launch when
# unset (operator token -> data/operator.token, judge passcode -> data/judge.passcode).
# Minimum lengths: operator token 24 characters, judge passcode 12 (random). Shorter values are
# ignored by the API and dev.py refuses to start with them: length is what stops guessing.
COUNTERPROOF_OPERATOR_TOKEN=
COUNTERPROOF_JUDGE_PASSCODE=
# Browser origins allowed to make cookie-authenticated changes, and extra Host names the API
# answers for (127.0.0.1, localhost are always allowed). Set COOKIE_SECURE=1 behind https.
COUNTERPROOF_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
COUNTERPROOF_ALLOWED_HOSTS=
COUNTERPROOF_COOKIE_SECURE=0
COUNTERPROOF_SESSION_HOURS=8
# 1 only when a reverse proxy in front of the API appends the real client address to
# X-Forwarded-For (failed sign-ins are then limited per client). Leave 0 behind the Next.js
# /api rewrite: it adds no X-Forwarded-For, so any value there came from the browser.
COUNTERPROOF_TRUSTED_PROXY=0

# --- server-side limits (backend/counterproof/limits.py) --------------------------------------
# Caller budgets are clamped to these caps; 0 or absent never means "unlimited".
# Judge caps (defaults shown); the operator has higher caps (COUNTERPROOF_OPERATOR_MAX_*).
COUNTERPROOF_JUDGE_MAX_SEQUENCES=50
COUNTERPROOF_JUDGE_MAX_WALL_SECONDS=300
COUNTERPROOF_JUDGE_MAX_MODEL_CALLS=60
COUNTERPROOF_JUDGE_MAX_MODEL_TOKENS=60000
COUNTERPROOF_JUDGE_MAX_ACTIVE_JOBS=2
COUNTERPROOF_JUDGE_DAILY_TOKENS=200000
# All judge sessions together (signing in again opens a session with fresh per-session quotas;
# these do not reset). Keep them below MAX_QUEUED_JOBS and DAILY_TOKEN_CEILING so the
# operator's own work always has room.
COUNTERPROOF_JUDGE_TOTAL_ACTIVE_JOBS=8
COUNTERPROOF_JUDGE_TOTAL_DAILY_TOKENS=500000
# Operator caps: 100000 sequences, 3600 s, 400 model calls, 600000 tokens per run.
COUNTERPROOF_OPERATOR_MAX_SEQUENCES=100000
COUNTERPROOF_OPERATOR_MAX_WALL_SECONDS=3600
COUNTERPROOF_OPERATOR_MAX_MODEL_CALLS=400
COUNTERPROOF_OPERATOR_MAX_MODEL_TOKENS=600000
# Queued + running jobs, whoever queued them (429 beyond).
COUNTERPROOF_MAX_QUEUED_JOBS=20
# Model tokens per UTC day across everything; past it new model jobs get 429 and model calls in
# flight fail as "unavailable" (runner_failure, retryable - never a verdict about the target).
COUNTERPROOF_DAILY_TOKEN_CEILING=1000000

# --- misc ------------------------------------------------------------------------------------
COUNTERPROOF_API_PORT=8010
COUNTERPROOF_DATA_DIR=
